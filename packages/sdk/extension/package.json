{
  "name": "@verified-attention/extension-sdk",
  "version": "0.1.0-dev",
  "description": "Browser Extension SDK for Verified Attention Protocol",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts",
    "dev": "tsdown src/index.ts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "tsdown": "^0.11.0",
    "vitest": "^1.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}