{
  "name": "@verified-attention/browser-sdk",
  "version": "0.1.0-dev",
  "description": "Browser SDK for Verified Attention Protocol",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts",
    "dev": "tsdown src/index.ts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@verified-attention/core": "workspace:*",
    "zod": "^3.22.4"
  },

  "devDependencies": {
    "typescript": "^5.3.3",
    "tsdown": "^0.11.0",
    "vitest": "^1.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
