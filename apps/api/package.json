{
  "name": "@verified-attention/api",
  "version": "0.1.0-dev",
  "description": "VAE public REST API service - VAP endpoints for sessions, evidence, proofs, verification.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@verified-attention/auth": "workspace:*",
    "@verified-attention/core": "workspace:*",
    "@verified-attention/privacy-consent": "workspace:*",
    "@verified-attention/privacy-minimisation": "workspace:*",
    "@verified-attention/privacy-pseudonymisation": "workspace:*",
    "@verified-attention/privacy-retention": "workspace:*",
    "@verified-attention/verification": "workspace:*",
    "@verified-attention/verifier": "workspace:*",
    "express": "^4.21.0",
    "zod": "^3.22.4",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/auto-instrumentations-node": "^0.53.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "tsdown": "^0.22.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}